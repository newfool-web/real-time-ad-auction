{
  "name": "rtb-ad-auction",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Ad Auction Bidding Engine — RTB simulation platform",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:engine": "pnpm --filter @rtb/auction-engine dev",
    "dev:bidder": "pnpm --filter @rtb/bidder dev",
    "dev:dashboard": "pnpm --filter @rtb/dashboard dev",
    "up": "docker compose up --build",
    "down": "docker compose down -v"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
